<view class="container">

<!-- 自动轮播推荐（只显示前4个菜品） -->
<view class="swiper-box">
  <swiper 
    class="swiper" 
    autoplay 
    circular 
    indicator-dots 
    interval="3000" 
    duration="500"
    indicator-active-color="#ff6700"
  >
    <swiper-item wx:for="{{swiperFoods}}" wx:key="id">
      <!-- 👇 这里加了点击事件 -->
      <view class="swiper-item" bindtap="goToDetail" data-id="{{item.id}}">
        <image src="{{item.img}}" class="swiper-img" mode="aspectFill"></image>
        <view class="swiper-name">{{item.name}}</view>
        <view class="swiper-price">¥{{item.price}}</view>
      </view>
    </swiper-item>
  </swiper>
</view>

<view class="page-title">菜品列表</view>

<!-- 菜品列表 -->
<!-- 👇 这里也加了点击事件 -->
<view class="food-item" wx:for="{{foods}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
  <image class="food-img" src="{{item.img}}" mode="aspectFill"></image>
  <view class="food-info">
    <view class="food-name">{{item.name}}</view>
    <view class="food-price">¥{{item.price}}</view>
  </view>
  <button class="add-btn" bindtap="addToCart" data-id="{{item.id}}">加入购物车</button>
</view>

</view>