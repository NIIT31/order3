/* 页面全局样式 */
page {
  background-color: #f8f8f8;
  padding: 20rpx;
}

/* 页面标题 */
.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin: 20rpx 0 30rpx 20rpx;
}

/* 空购物车提示 */
.empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  margin-top: 200rpx;
}

/* 购物车菜品卡片 */
.cart-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  gap: 20rpx;
}

/* 菜品图片（和首页共用，自动显示） */
.food-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  object-fit: cover;
  flex-shrink: 0;
}

/* 菜品信息区域 */
.food-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
}

/* 菜品名称 */
.food-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

/* 菜品价格（橙色高亮） */
.food-price {
  font-size: 28rpx;
  font-weight: bold;
  color: #ff6700;
}

/* 数量控制区域 */
.count-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

/* 加减按钮 */
.count-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background-color: #ff6700;
  color: #ffffff;
  border-radius: 50%;
  font-size: 32rpx;
  font-weight: bold;
}

/* 数量数字 */
.count-num {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  min-width: 40rpx;
  text-align: center;
}

/* 总价栏 */
.total-bar {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 30rpx 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  margin: 20rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.total-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.total-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff6700;
  margin-left: 10rpx;
}

/* 按钮组 */
.btn-group {
  display: flex;
  gap: 20rpx;
  padding: 0 20rpx;
}

/* 清空按钮 */
.clear-btn {
  flex: 1;
  background-color: #f0f0f0 !important;
  color: #666 !important;
  border: none !important;
  border-radius: 50rpx !important;
  font-size: 28rpx !important;
  padding: 16rpx 0 !important;
}

.clear-btn::after {
  border: none;
}

/* 结算按钮 */
.checkout-btn {
  flex: 2;
  background-color: #ff6700 !important;
  color: #ffffff !important;
  border: none !important;
  border-radius: 50rpx !important;
  font-size: 30rpx !important;
  font-weight: bold !important;
  padding: 16rpx 0 !important;
}

.checkout-btn::after {
  border: none;
}