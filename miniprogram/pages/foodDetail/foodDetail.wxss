/* 推荐样式 */
.recommend-title {
  font-size: 32rpx;
  font-weight: bold;
  margin: 40rpx 0 20rpx;
  padding-left: 20rpx;
}
.recommend-scroll {
  white-space: nowrap;
  padding-left: 20rpx;
}
.recommend-item {
  display: inline-block;
  width: 220rpx;
  margin-right: 20rpx;
}
.recommend-img {
  width: 220rpx;
  height: 220rpx;
  border-radius: 10rpx;
}
.recommend-name {
  font-size: 26rpx;
  margin-top: 10rpx;
}
.recommend-price {
  color: red;
  font-size: 24rpx;
}