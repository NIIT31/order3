.splash-container {
  width: 100%;
  height: 100vh;
  background-color: #ff6700;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
}

.logo-img {
  width: 800rpx;
  height: 800rpx;
  margin-bottom: 60rpx;
  object-fit: fill;
}

.title-box {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-bottom: 30rpx;
}

.title-word {
  font-weight: bold;
  text-shadow: 3rpx 3rpx 0 #b34700;
  animation: wordJump 0.8s ease forwards;
  opacity: 0;
}

/* 逐个弹入动画 */
.word1 {
  font-size: 70rpx;
  animation-delay: 0.2s;
}
.word2 {
  font-size: 85rpx;
  animation-delay: 0.4s;
}
.word3 {
  font-size: 70rpx;
  animation-delay: 0.6s;
}
.word4 {
  font-size: 85rpx;
  animation-delay: 0.8s;
}

@keyframes wordJump {
  0% {
    transform: translateY(50rpx);
    opacity: 0;
  }
  60% {
    transform: translateY(-10rpx);
  }
  100% {
    transform: translateY(0);
    opacity: 1;
  }
}

.desc {
  font-size: 28rpx;
  opacity: 0.8;
  animation: fadeIn 1s ease 1s forwards;
  opacity: 0;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 0.8;
  }
}