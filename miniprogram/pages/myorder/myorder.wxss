page {
  background: #f5f5f5;
}
.container {
  padding: 20rpx;
}
.title {
  font-size: 36rpx;
  margin-bottom: 30rpx;
  font-weight: bold;
}
.empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  margin-top: 100rpx;
}
.order-card {
  background: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.order-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #eee;
}
.order-id {
  font-size: 24rpx;
  color: #666;
}
.order-time {
  font-size: 24rpx;
  color: #999;
}
.order-item {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 28rpx;
}
.order-total {
  text-align: right;
  font-size: 32rpx;
  color: #ff6700;
  font-weight: bold;
  margin-top: 15rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #eee;
}