<view class="container">
  <view class="title">我的订单</view>

  <!-- 空订单提示 -->
  <view wx:if="{{orders.length === 0}}" class="empty">
    暂无订单
  </view>

  <!-- 订单列表 -->
  <view class="order-card" wx:for="{{orders}}" wx:key="id">
    <view class="order-header">
      <view class="order-id">订单号：{{item.id}}</view>
      <view class="order-time">{{item.time}}</view>
    </view>

    <view class="order-item" wx:for="{{item.list}}" wx:for-item="goods" wx:key="id">
      <view>{{goods.name}}</view>
      <view>x{{goods.num}}</view>
      <view>¥{{goods.price * goods.num}}</view>
    </view>

    <view class="order-total">
      订单总价：¥{{item.total}}
    </view>
  </view>
</view>