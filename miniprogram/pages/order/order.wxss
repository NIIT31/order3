.container {
  padding: 20rpx;
}
.title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  color: #333;
}
.empty {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  margin-top: 200rpx;
}
.order-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.order-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 15rpx;
  color: #666;
  font-size: 24rpx;
}
.food-list {
  margin-bottom: 15rpx;
}
.food-item {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}
.order-total {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff6700;
  text-align: right;
}